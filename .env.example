# ---------------------------------------------------------------------------
# Brigadely website: environment variables for Payload CMS (blog + /admin).
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this example file is committed, so never put real secrets in it.
# ---------------------------------------------------------------------------

# --- Database: Neon PostgreSQL -----------------------------------------------
# Use the POOLED connection string:
#   Neon console -> your project -> Dashboard -> "Connect" -> enable
#   "Connection pooling" -> copy the string (the host contains "-pooler").
# Example:
#   postgresql://USER:PASSWORD@ep-example-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URI=

# --- Payload ----------------------------------------------------------------
# Signs admin login tokens. Use a long random string, with a DIFFERENT value
# in each environment. Generate one with:
#   openssl rand -base64 24
PAYLOAD_SECRET=replace-with-a-random-32-character-string

# --- Media storage: S3 or an S3-compatible service ----------------------------
# Cover images, author avatars and images inside articles are stored here.
# The credentials need read, write and delete access to the bucket.
# The bucket can stay private: files are served through /api/media/file/...
#
# S3_ENDPOINT: leave empty for AWS S3. For an S3-compatible service set its
# endpoint, e.g. Neon object storage (Neon console -> Storage -> Connect):
#   https://br-xxxx-xxxxxxxx.storage.c-8.us-east-2.aws.neon.tech
# Neon labels these AWS_ENDPOINT_URL_S3, AWS_REGION, AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY; copy them into the S3_* names below.
#
# Local development only: leave these empty to store uploads on disk in
# ./media instead. Production must set them, or uploads are lost when the
# container is replaced.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
