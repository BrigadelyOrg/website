# ---------------------------------------------------------------------------
# Brigadely website: environment variables for Payload CMS (blog + /admin).
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this example file is committed, so never put real secrets in it.
# ---------------------------------------------------------------------------

# --- Database: Neon PostgreSQL -----------------------------------------------
# Use the POOLED connection string:
#   Neon console -> your project -> Dashboard -> "Connect" -> enable
#   "Connection pooling" -> copy the string (the host contains "-pooler").
# Example:
#   postgresql://USER:PASSWORD@ep-example-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URI=

# --- Payload ----------------------------------------------------------------
# Signs admin login tokens. Use a long random string, with a DIFFERENT value
# in each environment. Generate one with:
#   openssl rand -base64 24
PAYLOAD_SECRET=replace-with-a-random-32-character-string

# --- Media storage: S3 or an S3-compatible service ----------------------------
# Cover images, author avatars and images inside articles are stored here.
# The credentials need read, write and delete access to the bucket.
# The bucket can stay private: files are served through /api/media/file/...
#
# S3_ENDPOINT: leave empty for AWS S3. For an S3-compatible service set its
# endpoint, e.g. Neon object storage (Neon console -> Storage -> Connect):
#   https://br-xxxx-xxxxxxxx.storage.c-8.us-east-2.aws.neon.tech
# Neon labels these AWS_ENDPOINT_URL_S3, AWS_REGION, AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY; copy them into the S3_* names below.
#
# Local development only: leave these empty to store uploads on disk in
# ./media instead. Production must set them, or uploads are lost when the
# container is replaced.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Google Analytics 4 -------------------------------------------------------
# Page-view tracking on the public site (the /admin panel is never tracked).
#
# IMPORTANT: Google Tag Manager (GTM-NQPV8M79, in app/(frontend)/layout.jsx)
# already sends page views to the GA4 web stream G-4ZN7WY06BD. Leave this EMPTY
# unless you remove the GA4 tag from GTM or want a second, separate property:
# setting it to G-4ZN7WY06BD counts every page view twice.
# Where to find it: GA4 -> Admin -> Data streams -> (web stream) -> Measurement ID.
# Not a secret: it ships in the page's JavaScript. Changing it needs a rebuild,
# because Next.js inlines NEXT_PUBLIC_* values at build time.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Blog analytics dashboard in /admin (reads the GA4 Data API, read-only).
# One-time setup:
#   1. Google Cloud console -> APIs & Services -> enable "Google Analytics Data API".
#   2. IAM & Admin -> Service accounts -> create one (it needs no Cloud roles)
#      -> Keys -> Add key -> JSON. Keep the downloaded file private.
#   3. GA4 -> Admin -> Property access management -> add the service account's
#      email with the Viewer role.
# Until all three values below are set, the dashboard shows these setup steps.
#
# GA4_PROPERTY_ID: the numeric Property ID (GA4 -> Admin -> Property details),
# e.g. 412345678. Not the G-... measurement ID.
GA4_PROPERTY_ID=
# GA4_CLIENT_EMAIL: "client_email" from the JSON key,
# e.g. blog-analytics@your-project.iam.gserviceaccount.com
GA4_CLIENT_EMAIL=
# GA4_PRIVATE_KEY: "private_key" from the JSON key. In this file keep it on one
# line, in double quotes, with the \n escapes exactly as they appear in the JSON:
#   GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# In the Netlify UI paste the same value (quotes optional; real line breaks also
# work) and mark it as containing a secret value.
GA4_PRIVATE_KEY=
